<manifest xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.type.watch" android:required="true" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <uses-feature android:name="android.software.companion_device_setup" android:required="false" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="app.sugarwear.permission.READ_G7_DATA" />
    <uses-permission android:name="app.sugarwear.permission.CONFIGURE_G7" />
    <permission android:name="app.sugarwear.permission.READ_G7_DATA" android:protectionLevel="signature" />
    <permission android:name="app.sugarwear.permission.CONFIGURE_G7" android:protectionLevel="signature" />

    <queries>
        <package android:name="app.sugarlicious" />
        <package android:name="app.sugarwear" />
        <package android:name="app.aapswear.g7watch" />
        <package android:name="com.monotype.android.font.samsungone" />
        <intent><action android:name="android.settings.IGNORE_BATTERY_OPTIMIZATION_SETTINGS" /></intent>
        <intent><action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" /><data android:scheme="package" /></intent>
        <intent><action android:name="android.settings.APP_NOTIFICATION_SETTINGS" /></intent>
        <intent><action android:name="android.settings.CHANNEL_NOTIFICATION_SETTINGS" /></intent>
        <intent><action android:name="android.settings.NOTIFICATION_POLICY_ACCESS_SETTINGS" /></intent>
        <intent><action android:name="android.settings.REQUEST_SCHEDULE_EXACT_ALARM" /><data android:scheme="package" /></intent>
        <intent><action android:name="android.settings.SETTINGS" /></intent>
    </queries>

    <application android:name=".SugarWearApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_cgm_launcher"
        android:roundIcon="@mipmap/ic_cgm_launcher"
        android:label="@string/app_name"
        android:theme="@style/CgmWatchTheme"
        android:usesCleartextTraffic="false">
        <provider android:name=".ProductMigrationProvider" android:authorities="${applicationId}.product-migration" android:exported="true" android:initOrder="1000" tools:ignore="ExportedContentProvider" />

        <service android:name=".CgmAlarmAudioService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <activity android:name=".CgmAlarmActivity" android:exported="false" android:excludeFromRecents="true" android:noHistory="true" android:launchMode="singleTop" android:showWhenLocked="true" android:turnScreenOn="true" android:taskAffinity="" />
        <meta-data android:name="com.google.android.wearable.standalone" android:value="true" />
        <activity
            android:name=".CgmWatchActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".CgmAppearanceActivity"
            android:exported="false"
            android:taskAffinity="" />
        <activity
            android:name=".CgmDirectToWatchSettingsActivity"
            android:exported="false"
            android:taskAffinity="" />
        <activity android:name=".CgmPermissionsActivity" android:exported="false" android:taskAffinity="" />
        <activity
            android:name=".CgmSettingsActivity"
            android:exported="false"
            android:taskAffinity="" />
        <activity android:name=".CgmSetupActivity" android:exported="false" android:taskAffinity="" />
        <activity
            android:name=".CgmAlarmSettingsActivity"
            android:exported="false"
            android:taskAffinity="" />
        <activity
            android:name=".CgmSystemStatusActivity"
            android:exported="false"
            android:taskAffinity="" />
        <service
            android:name=".CgmCollectorService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <service
            android:name=".CgmCollectorTileService"
            android:label="@string/tile_cgm_label"
            android:description="@string/tile_cgm_description"
            android:icon="@drawable/ic_tile_brand"
            android:exported="true"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter><action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" /></intent-filter>
            <meta-data android:name="androidx.wear.tiles.PREVIEW" android:resource="@drawable/tile_preview_cgm" />
        </service>
        <service
            android:name=".CgmGraphTileService"
            android:label="@string/tile_graph_label"
            android:description="@string/tile_graph_description"
            android:icon="@drawable/ic_tile_brand"
            android:exported="true"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter><action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" /></intent-filter>
            <meta-data android:name="androidx.wear.tiles.PREVIEW" android:resource="@drawable/tile_preview_graph" />
        </service>
        <receiver android:name=".CgmBootReceiver" android:enabled="true" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".CgmReconnectReceiver" android:exported="false" />
        <receiver android:name=".CgmBluetoothStateReceiver" android:exported="false">
            <intent-filter><action android:name="android.bluetooth.adapter.action.STATE_CHANGED" /></intent-filter>
        </receiver>
        <receiver android:name=".CgmSensorWindowWatchdogReceiver" android:exported="false" />
        <receiver android:name=".CgmAdvertisementWakeReceiver" android:exported="false" />
        <receiver android:name=".CgmSignalLossReceiver" android:exported="false" />
        <receiver android:name=".CgmErrorAcknowledgeReceiver" android:exported="false" />
        <receiver android:name=".CgmAlarmVolumeRestoreReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
        </receiver>
        <receiver android:name=".CgmAlarmAcknowledgeReceiver" android:exported="false" />
        <receiver android:name=".CgmAlarmRepeatReceiver" android:exported="false" />
        <receiver
            android:name=".CgmSetupReceiver"
            android:exported="true"
            android:permission="app.sugarwear.permission.CONFIGURE_G7">
            <intent-filter><action android:name="app.aapswear.g7watch.CONFIGURE" /></intent-filter>
        </receiver>
        <receiver
            android:name=".CgmSourceControlReceiver"
            android:exported="true"
            android:permission="app.sugarwear.permission.CONFIGURE_G7">
            <intent-filter><action android:name="app.aapswear.g7watch.SET_SOURCE" /></intent-filter>
        </receiver>
        <receiver
            android:name=".CgmColorSyncReceiver"
            android:exported="true"
            android:permission="app.sugarwear.permission.CONFIGURE_G7">
            <intent-filter><action android:name="app.aapswear.g7watch.APPLY_GRAPH_COLORS" /></intent-filter>
        </receiver>
        <provider
            android:name=".CgmReadingProvider"
            android:authorities="${applicationId}.readings"
            android:exported="true"
            android:readPermission="app.sugarwear.permission.READ_G7_DATA" />
        <provider
            android:name=".CgmAlarmSoundProvider"
            android:authorities="${applicationId}.alarm-sounds"
            android:exported="false"
            android:grantUriPermissions="true" />
        <service android:name="app.sugarlicious.complications.GlucoseComplication" android:label="Glukose" android:exported="true" android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER"><intent-filter><action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/></intent-filter><meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT"/><meta-data android:name="com.google.android.wearable.complications.STATIC_PREVIEW_DATA" android:resource="@xml/complication_preview_01a_short"/></service>
        <service android:name="app.sugarlicious.complications.GlucoseLongTextComplication" android:label="Glukose · Details" android:exported="true" android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER"><intent-filter><action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/></intent-filter><meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="LONG_TEXT"/><meta-data android:name="com.google.android.wearable.complications.STATIC_PREVIEW_DATA" android:resource="@xml/complication_preview_01b_long"/></service>
        <service android:name="app.sugarlicious.complications.GlucoseRangedValueComplication" android:label="Glukose · Fortschritt" android:exported="true" android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER"><intent-filter><action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/></intent-filter><meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="RANGED_VALUE"/><meta-data android:name="com.google.android.wearable.complications.STATIC_PREVIEW_DATA" android:resource="@xml/complication_preview_01c_ranged"/></service>
        <service android:name="app.sugarlicious.complications.GlucoseTrendComplication" android:label="Glukose · Trend" android:exported="true" android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER"><intent-filter><action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/></intent-filter><meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT"/><meta-data android:name="com.google.android.wearable.complications.STATIC_PREVIEW_DATA" android:resource="@xml/complication_preview_02a_short"/></service>
        <service android:name="app.sugarlicious.complications.GlucoseTrendLongTextComplication" android:label="Glukose · Trend · Details" android:exported="true" android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER"><intent-filter><action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/></intent-filter><meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="LONG_TEXT"/><meta-data android:name="com.google.android.wearable.complications.STATIC_PREVIEW_DATA" android:resource="@xml/complication_preview_02b_long"/></service>
        <service android:name="app.sugarlicious.complications.GlucoseTrendRangedValueComplication" android:label="Glukose · Trend · Fortschritt" android:exported="true" android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER"><intent-filter><action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/></intent-filter><meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="RANGED_VALUE"/><meta-data android:name="com.google.android.wearable.complications.STATIC_PREVIEW_DATA" android:resource="@xml/complication_preview_02c_ranged"/></service>
        <service android:name="app.sugarlicious.complications.TrendOnlyComplication" android:label="Trend" android:exported="true" android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER"><intent-filter><action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/></intent-filter><meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT"/><meta-data android:name="com.google.android.wearable.complications.STATIC_PREVIEW_DATA" android:resource="@xml/complication_preview_08_short"/></service>
        <service android:name="app.sugarlicious.complications.GlucoseDeltaComplication" android:label="Zeit · Delta" android:exported="true" android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER"><intent-filter><action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/></intent-filter><meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT"/><meta-data android:name="com.google.android.wearable.complications.STATIC_PREVIEW_DATA" android:resource="@xml/complication_preview_11_short"/></service>
    </application>
</manifest>
